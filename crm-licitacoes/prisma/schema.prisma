// CRM de Licitações e Gestão Comercial — Prisma Schema
// PostgreSQL (via DATABASE_URL env) — mesmo schema para desenvolvimento e produção
// (ex: Vercel Postgres/Neon). Ver README para como apontar para um banco local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Observação: os campos abaixo marcados com "String —" usam String simples em vez de
// `enum` nativo do Prisma (os valores permitidos são validados na camada de aplicação,
// ver src/types/deal.ts). Isso mantém o schema portável — funciona sem alterações caso
// DATABASE_URL aponte para SQLite em algum ambiente local, além de Postgres.

// Role:           "ADMIN" | "USER"
// DealCategory:   "ANDAMENTO" | "PARALISADA" | "GANHO" | "PERDIDO" | "GARANTIA" | "CONCLUIDO" | "ARQUIVADO"
// LossReason:     "PRECO" | "ESPECIFICACAO_INADEQUADA" | "FALTA_DOCUMENTACAO" | "DISTANCIA" | "OUTROS"
// ReminderStatus: "PENDING" | "DONE"
// EventStatus:    "ABERTO" | "EM_ANALISE" | "GANHO" | "PERDIDO"

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("USER") // String — Role
  allowedStates String   @default("[]") // JSON string array de siglas, ex: ["MG","SP"]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dealsCreated  Deal[]     @relation("DealCreatedBy")
  dealsAssigned Deal[]     @relation("DealAssignedTo")
  notes         Note[]
  reminders     Reminder[] @relation("ReminderAssignedTo")
  auditLogs     AuditLog[]
  eventsCreated Event[]    @relation("EventCreatedBy")

  @@map("users")
}

model Deal {
  id           String  @id @default(cuid())
  title        String
  client       String
  city         String
  state        String // sigla UF, ex: "MG"
  equipment    String?
  model        String?
  serialNumber String?

  category String @default("ANDAMENTO") // String — DealCategory
  status   String // status dinâmico conforme a categoria (ver src/types)

  lossReason String? // String — LossReason
  lossDetail String?

  deadline DateTime?

  archivedYear  Int?
  archivedMonth Int?

  createdById  String
  createdBy    User    @relation("DealCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("DealAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes       Note[]
  reminders   Reminder[]
  attachments Attachment[]
  auditLogs   AuditLog[]
  events      Event[]

  @@index([category])
  @@index([state])
  @@index([city])
  @@index([assignedToId])
  @@map("deals")
}

model Note {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("notes")
}

model Reminder {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User     @relation("ReminderAssignedTo", fields: [assignedToId], references: [id])
  dueDate      DateTime
  description  String
  status       String   @default("PENDING") // String — ReminderStatus
  createdAt    DateTime @default(now())

  @@index([dealId])
  @@index([assignedToId])
  @@map("reminders")
}

model Attachment {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())

  @@index([dealId])
  @@map("attachments")
}

model AuditLog {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("audit_logs")
}

/// Evento do módulo de Calendário. Pode ser um compromisso avulso (dealId nulo) ou estar
/// vinculado a um processo/licitação (dealId preenchido) — nesse caso o card de detalhes no
/// calendário exibe também o cliente/órgão do processo. As datas de prazo (`Deal.deadline`)
/// já aparecem automaticamente no calendário sem precisar de um Event — este model cobre os
/// compromissos criados manualmente pelo usuário (reuniões, aberturas, entregas, etc.).
model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  status         String    @default("ABERTO") // String — EventStatus
  estimatedValue Float?

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([dealId])
  @@map("events")
}

/// Pasta do Repositório de Documentos (aba "Documentos" do menu lateral) — não tem
/// relação com Deal/processo (RBAC por UF não se aplica: é um repositório compartilhado
/// da equipe). Hierarquia de 2 níveis, imposta na camada de aplicação (actions/documents.ts):
///   - Pasta de Estado: `state` preenchido (sigla UF), `parentId` nulo — raiz do grid em
///     /documentos, uma por UF (ex: "MG"). Pode ter arquivos direto e/ou subpastas.
///   - Subpasta: `parentId` aponta para uma pasta de Estado, `state` nulo — organização
///     livre dentro do estado (ex: "CNDs Municipais", "FGTS"). Não tem subpastas próprias.
/// `color` é uma das cores de DOCUMENT_FOLDER_COLORS (src/types/document.ts), escolhida
/// na criação só para dar variedade visual ao grid — não tem outro significado.
model DocumentFolder {
  id    String  @id @default(cuid())
  name  String
  color String  @default("#3b82f6")
  state String? // sigla UF — só em pastas de Estado (raiz)

  parentId   String?
  parent     DocumentFolder?  @relation("DocumentFolderSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders DocumentFolder[] @relation("DocumentFolderSubfolders")

  // String livre (nome/e-mail do autor no momento da criação) em vez de FK para User —
  // evita erro de chave estrangeira caso o id de sessão não bata com um User existente
  // no banco de produção (causa raiz de um problema real já visto neste projeto).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files DocumentFile[]

  @@index([parentId])
  @@index([state])
  @@map("document_folders")
}

/// Arquivo dentro de uma DocumentFolder (pasta de Estado ou subpasta) — mesmo padrão de
/// armazenamento de Attachment (data URL base64 em `url`, ver actions/attachments.ts):
/// sem depender de um serviço de blob storage externo, funciona imediatamente em
/// qualquer ambiente com só DATABASE_URL configurado. `expiryDate`/`notes` sustentam o
/// controle de validade de certidões (CNDs, alvarás, etc.) e seus alertas na Central de
/// Notificações (ver src/lib/urgency.ts -> getDocumentUrgency).
model DocumentFile {
  id       String @id @default(cuid())
  name     String
  url      String @db.Text
  fileType String
  size     Int // bytes

  expiryDate DateTime?
  notes      String?

  folderId String
  folder   DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // Mesmo raciocínio de DocumentFolder.createdBy acima — string livre, não FK.
  uploadedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([expiryDate])
  @@map("document_files")
}
