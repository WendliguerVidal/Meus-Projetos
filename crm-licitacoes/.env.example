# Banco de dados — PostgreSQL (local, Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/crm_licitacoes?schema=public"

# NextAuth / Auth.js — gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-seguro"

# Local: URL do servidor de desenvolvimento.
# Na Vercel: NÃO defina esta variável — a Vercel injeta VERCEL_URL automaticamente
# e o auth.config.ts (trustHost: true) resolve a URL pública a partir do request.
NEXTAUTH_URL="http://localhost:3000"

# Chave de API da Anthropic — necessária para a importação automática de editais (PDF) via
# IA ("Importar Edital (PDF)"). Gere em https://console.anthropic.com/settings/keys.
# Sem esta variável, a importação por PDF mostra um aviso amigável e continua indisponível
# — o restante do CRM funciona normalmente.
ANTHROPIC_API_KEY="sk-ant-..."
